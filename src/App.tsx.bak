import { useState, useEffect } from 'react'

// ─── Types ───────────────────────────────────────────────────────────────────
type View = 'home' | 'collection' | 'lineup' | 'product' | 'story'
type CartItem = { product: Product; size: string; qty: number }

interface Product {
  id: string
  name: string
  nameJa: string
  price: number
  material: string
  description: string
  sizes: string[]
  color: string
  colorName: string
  image: string
  images: string[]
  category: string
}

